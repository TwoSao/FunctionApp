@model FunctionApp.Models.FunktsiooniUurimine

@{
    ViewData["Title"] = "Funktsiooni detailid";
}

<h2>Funktsiooni uurimine</h2>
<hr />

<div class="row">
    <div class="col-md-5">
        <dl class="row">
            <dt class="col-sm-4">Valem</dt>
            <dd class="col-sm-8">@Model.Valem</dd>

            <dt class="col-sm-4">Määramispiirkond</dt>
            <dd class="col-sm-8">@Model.Maaramispiirkond</dd>

            <dt class="col-sm-4">Tuletis f'(x)</dt>
            <dd class="col-sm-8">@Model.Tuletis</dd>

            <dt class="col-sm-4">Kriitilised punktid</dt>
            <dd class="col-sm-8">@Model.KriitilisedPunktid</dd>

            <dt class="col-sm-4">Ekstreemumid</dt>
            <dd class="col-sm-8">@Model.Ekstreemumid</dd>

            <dt class="col-sm-4">Salvestatud</dt>
            <dd class="col-sm-8">@Model.LuodudAeg.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Muuda</a>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm ms-2">Tagasi nimekirja</a>
    </div>

    <div class="col-md-7">
        <canvas id="funktsiooniGraafik"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mathjs/14.0.1/math.min.js"></script>
    <script>
        const valem = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Valem));

        const xArr = [], yArr = [];
        for (let x = -5; x <= 5; x += 0.1) {
            xArr.push(Number(x.toFixed(2)));
            try { yArr.push(Number(math.evaluate(valem, { x }))); }
            catch { yArr.push(null); }
        }

        new Chart(document.getElementById("funktsiooniGraafik"), {
            type: "line",
            data: {
                labels: xArr,
                datasets: [{
                    label: "f(x) = " + valem,
                    data: yArr,
                    borderColor: "blue",
                    borderWidth: 2,
                    pointRadius: 0,
                    tension: 0.2,
                    fill: false
                }]
            },
            options: {
                responsive: true,
                scales: {
                    x: { title: { display: true, text: "x" } },
                    y: { title: { display: true, text: "y" } }
                }
            }
        });
    </script>
}
