@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    ```
    <script>
        const input = document.getElementById("valemInput");

        function lisa(tekst) {

            const start = input.selectionStart;
            const end = input.selectionEnd;

            const vana = input.value;

            input.value =
                vana.substring(0, start) +
                tekst +
                vana.substring(end);

            input.focus();

            const uusPositsioon = start + tekst.length;

            input.setSelectionRange(
                uusPositsioon,
                uusPositsioon
            );
        }

        function uDalit() {
            const start = input.selectionStart;
            const end = input.selectionEnd;

            if (start === end && start > 0) {

                input.value =
                    input.value.substring(0, start - 1) +
                    input.value.substring(end);

                input.setSelectionRange(
                    start - 1,
                    start - 1
                );

            } else {

                input.value =
                    input.value.substring(0, start) +
                    input.value.substring(end);

                input.setSelectionRange(start, start);
            }

            input.focus();
        }

        function uDalit() {
            const start = input.selectionStart;
            const end = input.selectionEnd;

            if (start === end && start > 0) {
                input.value =
                    input.value.substring(0, start - 1) +
                    input.value.substring(start);

                input.setSelectionRange(start - 1, start - 1);
            }
            else {
                input.value =
                    input.value.substring(0, start) +
                    input.value.substring(end);

                input.setSelectionRange(start, start);
            }

            input.focus();
        }

        function puhasta() {
            input.value = "";
            input.focus();
        }

                function arvutaFunktsioon() {


        const valem = document.getElementById("valemInput").value
            .trim()
            .replace(/\s+/g, "");

        if (valem === "") {
            alert("Sisesta kõigepealt funktsioon.");
            return;
        }

        const maaramispiirkond =
            document.getElementById("maaramispiirkond");

        const tuletis =
            document.getElementById("tuletis");

        const kriitilised =
            document.getElementById("kriitilisedPunktid");

        const ekstreemumid =
            document.getElementById("ekstreemumid");


        // Määramispiirkond
        maaramispiirkond.value = "x ∈ ℝ";


        // x² - 4x + 3
        if (
            valem === "x^2-4*x+3" ||
            valem === "x^2-4x+3"
        ) {

            tuletis.value = "2*x - 4";

            kriitilised.value = "x = 2";

            ekstreemumid.value =
                "miinimum: (2; -1)";

            return;
        }


        // x³ - 3x
        if (
            valem === "x^3-3*x" ||
            valem === "x^3-3x"
        ) {

            tuletis.value = "3*x^2 - 3";

            kriitilised.value =
                "x = -1, x = 1";

            ekstreemumid.value =
                "maksimum: (-1; 2), miinimum: (1; -2)";

            return;
        }


        // Kui funktsioon pole пока поддерживается
        tuletis.value = "";
        kriitilised.value = "";
        ekstreemumid.value = "";

        alert(
            "Selle funktsiooni automaatne arvutamine ei ole veel lisatud."
        );
      

        }

    </script>


}
