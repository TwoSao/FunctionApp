@model FunctionApp.Models.FunktsiooniUurimine

@{
    ViewData["Title"] = "Details";
}

<h1>Funktsiooni uurimine</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Valem</dt>
        <dd class="col-sm-10">@Model.Valem</dd>

        ```
        <dt class="col-sm-2">Määramispiirkond</dt>
        <dd class="col-sm-10">@Model.Maaramispiirkond</dd>

        <dt class="col-sm-2">Tuletis</dt>
        <dd class="col-sm-10">@Model.Tuletis</dd>

        <dt class="col-sm-2">Kriitilised punktid</dt>
        <dd class="col-sm-10">@Model.KriitilisedPunktid</dd>

        <dt class="col-sm-2">Ekstreemumid</dt>
        <dd class="col-sm-10">@Model.Ekstreemumid</dd>

        <dt class="col-sm-2">Loodud aeg</dt>
        <dd class="col-sm-10">@Model.LuodudAeg</dd>
    </dl>
    ```

</div>

<hr />

<h3>Graafik</h3>

<canvas id="funktsiooniGraafik"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/mathjs/14.0.1/math.min.js"></script>

<script>
    const valem = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Valem));
    const tuletis = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tuletis));

    const xVaartused = [];
    const yFunktsioon = [];
    const yTuletis = [];

    for (let x = -5; x <= 5; x += 0.1) {
        xVaartused.push(Number(x.toFixed(2)));

        try {
            const f = math.evaluate(valem, { x: x });
            const df = math.evaluate(tuletis, { x: x });

            yFunktsioon.push(Number(f));
            yTuletis.push(Number(df));
        }
        catch (error) {
            yFunktsioon.push(null);
            yTuletis.push(null);
        }
    }

    new Chart(
        document.getElementById('funktsiooniGraafik'),
        {
            type: 'line',

            data: {
                labels: xVaartused,

                datasets: [
                    {
                        label: 'f(x) = ' + valem,
                        data: yFunktsioon,
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.2
                    },
                    {
                        label: "f'(x) = " + tuletis,
                        data: yTuletis,
                        borderWidth: 2,
                        borderDash: [6, 6],
                        pointRadius: 0,
                        tension: 0.2
                    }
                ]
            },

            options: {
                responsive: true,

                scales: {
                    x: {
                        title: {
                            display: true,
                            text: 'x'
                        }
                    },

                    y: {
                        title: {
                            display: true,
                            text: 'y'
                        }
                    }
                }
            }
        }
    );
</script>

<br />

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
