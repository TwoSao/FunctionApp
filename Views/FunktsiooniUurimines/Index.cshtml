@model IEnumerable<FunctionApp.Models.FunktsiooniUurimine>

@{
    ViewData["Title"] = "Salvestatud funktsioonid";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Salvestatud funktsioonid</h2>
    <a asp-action="Create" class="btn btn-primary">+ Lisa uus</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Ühtegi funktsiooni pole veel salvestatud.</p>
}
else
{
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Valem</th>
                <th>Tuletis</th>
                <th>Ekstreemumid</th>
                <th>Salvestatud</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Valem</td>
                    <td>@item.Tuletis</td>
                    <td>@item.Ekstreemumid</td>
                    <td>@item.LuodudAeg.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Vaata</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Muuda</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Kustuta</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
