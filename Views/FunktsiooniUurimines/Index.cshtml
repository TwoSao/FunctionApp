@model IEnumerable<FunctionApp.Models.FunktsiooniUurimine>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Valem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Maaramispiirkond)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tuletis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KriitilisedPunktid)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ekstreemumid)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LuodudAeg)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Valem)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Maaramispiirkond)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tuletis)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.KriitilisedPunktid)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ekstreemumid)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LuodudAeg)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
