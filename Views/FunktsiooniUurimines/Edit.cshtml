@model FunctionApp.Models.FunktsiooniUurimine

@{
    ViewData["Title"] = "Muuda funktsiooni";
}

<h2>Muuda funktsiooni</h2>
<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="LuodudAeg" />

            <div class="form-group mb-3">
                <label asp-for="Valem" class="control-label">Valem f(x)</label>
                <input asp-for="Valem" class="form-control" />
                <span asp-validation-for="Valem" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Maaramispiirkond" class="control-label">Määramispiirkond</label>
                <input asp-for="Maaramispiirkond" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Tuletis" class="control-label">Tuletis f'(x)</label>
                <input asp-for="Tuletis" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="KriitilisedPunktid" class="control-label">Kriitilised punktid</label>
                <input asp-for="KriitilisedPunktid" class="form-control" />
            </div>
            <div class="form-group mb-4">
                <label asp-for="Ekstreemumid" class="control-label">Ekstreemumid</label>
                <input asp-for="Ekstreemumid" class="form-control" />
            </div>

            <input type="submit" value="Salvesta muudatused" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Tühista</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
