@model FunctionApp.Models.FunktsiooniUurimine

@{
    ViewData["Title"] = "Kustuta funktsioon";
}

<h2>Kustuta funktsioon</h2>
<hr />

<div class="alert alert-warning">
    Kas oled kindel, et soovid selle funktsiooni kustutada?
</div>

<dl class="row">
    <dt class="col-sm-3">Valem</dt>
    <dd class="col-sm-9">@Model.Valem</dd>

    <dt class="col-sm-3">Tuletis</dt>
    <dd class="col-sm-9">@Model.Tuletis</dd>

    <dt class="col-sm-3">Ekstreemumid</dt>
    <dd class="col-sm-9">@Model.Ekstreemumid</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Kustuta" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Tühista</a>
</form>
